$ annotary -p down vault list --json ?
name documents deleted created id default_actions

$ annotary -p down vault create x --json ?
name documents deleted created id default_actions

$ annotary -p down vault rename x y --json ?
name from documents deleted created id default_actions profiles

$ annotary -p down vault delete x --json ?
