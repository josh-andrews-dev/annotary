$ annotary -p down settings list --json ?
key value source kind label group device

$ annotary -p down settings get k --json ?
key value source kind label group device

$ annotary -p down settings set k v --json ?
key value source kind label group device changed

$ annotary -p down settings reset k --json ?
key value source kind label group device changed

$ annotary -p down devices list --json ?
id kind name last_seen created forgotten

$ annotary -p down devices rename d n --json ?
id kind name last_seen created forgotten

$ annotary -p down devices forget d --json ?
id kind name forgotten tokens_revoked sessions_ended already

$ annotary -p down avatar set f --json ?
handle type size hash url static_type static_size static_hash static_url set_at changed

$ annotary -p down avatar clear --json ?
handle changed

$ annotary -p down avatar show --json ?
handle type size hash url static_type static_size static_hash static_url set_at changed

$ annotary -p down link x --json ?
